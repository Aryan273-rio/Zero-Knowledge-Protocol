# ZKP Auth Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# MongoDB connection URI.
# For local development, leave as default (uses in-memory mock).
# For production (MongoDB Atlas), set this to your Atlas connection string.
# Example: MONGO_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/
MONGO_URI=mongodb://localhost:27017/

# MongoDB database name. Change to isolate test/prod data.
MONGO_DB=zkp_clean_db
